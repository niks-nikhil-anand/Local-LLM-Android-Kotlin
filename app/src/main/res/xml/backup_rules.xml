<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup for Android 11 and lower. Model files are large and re-downloadable, and the
     download records describe those files, so neither is backed up. -->
<full-backup-content>
    <exclude domain="file" path="models/" />
    <exclude domain="database" path="local_models.db" />
</full-backup-content>
