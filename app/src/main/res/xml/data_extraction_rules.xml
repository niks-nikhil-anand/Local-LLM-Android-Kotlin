<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Model files and their download records are excluded from cloud backup and
     device transfer: they are large, re-downloadable, and the records must match the files. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models/" />
        <exclude domain="database" path="local_models.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
        <exclude domain="database" path="local_models.db" />
    </device-transfer>
</data-extraction-rules>
